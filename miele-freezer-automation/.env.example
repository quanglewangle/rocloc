# Miele Third Party API credentials
# Register at: https://www.miele.com/developer/
MIELE_CLIENT_ID=your_client_id_here
MIELE_CLIENT_SECRET=your_client_secret_here

# Obtained after first run of authenticate() -- save these to avoid re-login
MIELE_ACCESS_TOKEN=
MIELE_REFRESH_TOKEN=

# Optional: email alerts (all required if any are set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=you@example.com
SMTP_TO=you@example.com
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password
